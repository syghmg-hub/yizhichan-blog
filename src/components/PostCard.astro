---
import { tagPath } from '../utils/slug';

interface Props {
  title: string;
  description?: string;
  date: Date;
  category: string;
  tags: string[];
  href: string;
}

const { title, description, date, category, tags, href } = Astro.props;

// 全站统一日期格式：2026.10.06
const dateStr = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
---

<article class="post-card">
  <div class="post-card-meta">
    <span class="badge badge-category">{category}</span>
    <span class="meta-dot" aria-hidden="true"></span>
    <time datetime={date.toISOString()}>{dateStr}</time>
  </div>
  <h2 class="post-card-title">
    <a href={href} class="post-card-link">{title}</a>
  </h2>
  {description && <p class="post-card-desc">{description}</p>}
  {tags.length > 0 && (
    <div class="post-card-tags">
      {tags.map((tag) => (
        <a href={tagPath(tag)} class="badge badge-tag">#{tag}</a>
      ))}
    </div>
  )}
</article>