---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { tagPath } from '../../utils/slug';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 全站统一日期格式：2026.10.06
const dateStr = `${post.data.date.getFullYear()}.${String(post.data.date.getMonth() + 1).padStart(2, '0')}.${String(post.data.date.getDate()).padStart(2, '0')}`;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={post.data.title} description={post.data.description}>
  <header class="article-header">
    <div class="article-meta">
      <span class="badge badge-category">{post.data.category}</span>
      <time datetime={post.data.date.toISOString()}>{dateStr}</time>
      {post.data.tags.map((tag) => (
        <a href={tagPath(tag)} class="badge badge-tag">#{tag}</a>
      ))}
    </div>
    <h1>{post.data.title}</h1>
  </header>

  {toc.length > 2 && (
    <nav class="article-toc" aria-label="目录">
      <strong>目录</strong>
      <ul>
        {toc.map((h) => (
          <li class={`depth-${h.depth}`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <article class="article-body">
    <Content />
  </article>
</Base>

<style is:global>
  /* 轻量目录：左侧细竖线 + 双列排布，不再占用大块视觉重量 */
  .article-toc {
    margin: 0 0 34px;
    padding: 2px 0 2px 16px;
    border-left: 2px solid var(--accent-soft);
    font-size: 0.86rem;
  }

  .article-toc strong {
    display: block;
    margin-bottom: 8px;
    color: var(--text);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  .article-toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
    columns: 2;
    column-gap: 24px;
  }

  .article-toc li {
    margin: 4px 0;
    break-inside: avoid;
  }

  .article-toc li.depth-3 {
    padding-left: 14px;
    font-size: 0.82rem;
  }

  .article-toc a {
    color: var(--text-soft);
    display: block;
    line-height: 1.55;
  }

  .article-toc a:hover {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .article-toc ul {
      columns: 1;
    }
  }
</style>
