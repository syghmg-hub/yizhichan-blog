---
import Base from '../layouts/Base.astro';
import { siteConfig } from '../config';

const email = siteConfig.contactEmail.trim();
---

<Base title="关于">
  <header class="page-header">
    <h1>关于一只蝉</h1>
  </header>

  <article class="article-body">
    <p style="font-size:1.05rem">
      你好，这里是一只蝉的个人博客。
    </p>

    <h2>找到我</h2>
    {email ? (
      <p>
        有话想说，可以写信给我：<a href={`mailto:${email}`}>{email}</a>
      </p>
    ) : (
      <p class="contact-pending">
        联系方式待补充。
      </p>
    )}
    <p>
      也欢迎通过 <a href={siteConfig.rssPath}>RSS</a> 订阅，新文章会自动送到你的阅读器。
    </p>
  </article>
</Base>

<style>
  .contact-pending {
    color: var(--text-soft);
  }
</style>